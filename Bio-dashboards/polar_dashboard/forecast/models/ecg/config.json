{
  "activation_variant": "gelu",
  "architectures": [
    "CsvMcIntForCausalLM"
  ],
  "auto_map": {
    "AutoConfig": "configuration_csv_mc_int.CsvMcIntConfig",
    "AutoModelForCausalLM": "modeling_csv_mc_int.CsvMcIntForCausalLM"
  },
  "bias": false,
  "block_size": 256,
  "div_by_seq_len": false,
  "dropout": 0.3,
  "initializer_range": 0.02,
  "lane_loss_weights": null,
  "lanes": [
    {
      "column": "ecg_uv",
      "decode": "mV = value * 1 / 1000",
      "int_max": 2500,
      "int_min": -2500,
      "scale": 1000,
      "signal": "polar.ecg",
      "step": 1,
      "unit": "mV",
      "vocab_size": 5001
    }
  ],
  "learn_mlp_x_offset": false,
  "learn_mlp_y_offset": false,
  "mlp_expansion_factor": 4,
  "mlp_size": null,
  "mlp_x_offset": 0.0,
  "mlp_y_offset": 0.0,
  "model_type": "csv_mc_int",
  "n_embd": 384,
  "n_head": 6,
  "n_kv_group": 6,
  "n_layer": 6,
  "num_lanes": 1,
  "relu2max_divisor": 256.0,
  "rope_length": null,
  "sample_rate_hz": 125.0,
  "softmax_variant_attn": "softmax",
  "source": {
    "format": "bio-dash waves v2",
    "method": "one row every 8 ms (125 Hz) at whole multiples of 8 ms in epoch time; the ECG and each accelerometer axis interpolated linearly at every instant from their two neighbouring samples; pieces end at ECG steps over max_gap_ms and where the accelerometer neighbours are over acc_max_gap_ms apart; pieces under min_piece_s left out (Bio-dash analysis_dashboard/waves.py, grid method)",
    "settings": {
      "acc_clip_mg": 2000,
      "acc_max_gap_ms": 50.0,
      "acc_step_mg": 1,
      "ecg_clip_uv": 2500,
      "ecg_step_uv": 1,
      "grid_ms": 8,
      "max_gap_ms": 50.0,
      "min_piece_s": 30.0,
      "sample_rate_hz": 125.0,
      "with_acc": false
    }
  },
  "torch_dtype": "float32",
  "transformers_version": "4.53.3",
  "use_qk_norm": false,
  "use_qk_norm_scale": false,
  "use_rotary_embeddings": true,
  "vocab_sizes": [
    5001
  ]
}
