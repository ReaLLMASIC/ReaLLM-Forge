{
  "activation_variant": "gelu",
  "architectures": [
    "CsvMcIntForCausalLM"
  ],
  "auto_map": {
    "AutoConfig": "configuration_csv_mc_int.CsvMcIntConfig",
    "AutoModelForCausalLM": "modeling_csv_mc_int.CsvMcIntForCausalLM"
  },
  "bias": false,
  "block_size": 256,
  "div_by_seq_len": false,
  "dropout": 0.3,
  "initializer_range": 0.02,
  "lane_loss_weights": null,
  "lanes": [
    {
      "column": "ecg_uv",
      "decode": "mV = value * 1 / 1000",
      "int_max": 2500,
      "int_min": -2500,
      "scale": 1000,
      "signal": "polar.ecg",
      "step": 1,
      "unit": "mV",
      "vocab_size": 5001
    },
    {
      "column": "rr_ms",
      "decode": "ms = value",
      "int_max": 2500,
      "int_min": 0,
      "scale": 1,
      "signal": "polar.rr",
      "step": 1,
      "unit": "ms",
      "vocab_size": 2501
    }
  ],
  "learn_mlp_x_offset": false,
  "learn_mlp_y_offset": false,
  "mlp_expansion_factor": 4,
  "mlp_size": null,
  "mlp_x_offset": 0.0,
  "mlp_y_offset": 0.0,
  "model_type": "csv_mc_int",
  "n_embd": 384,
  "n_head": 6,
  "n_kv_group": 6,
  "n_layer": 6,
  "num_lanes": 2,
  "relu2max_divisor": 256.0,
  "rope_length": null,
  "sample_rate_hz": 125.0,
  "softmax_variant_attn": "softmax",
  "source": {
    "format": "bio-dash waves v2 + rr_ms (R-R proof of concept)",
    "method": "one row every 8 ms (125 Hz) at whole multiples of 8 ms in epoch time; the ECG interpolated linearly at every instant from its two neighbouring samples (Bio-dash analysis_dashboard/waves.py, grid method; pieces end at ECG steps over max_gap_ms, pieces under min_piece_s left out); rr_ms: beat times rebuilt from the R-R messages (the chain of R-R intervals, anchored to the message arrival times), a straight line between the beats either side of each instant, dropouts interpolated across, rows outside the first..last beat left out, only R-R from the recording's own day, recordings without R-R left out (rr_poc/export_ecg_rr.py)",
    "settings": {
      "acc_clip_mg": 2000,
      "acc_max_gap_ms": 50.0,
      "acc_step_mg": 1,
      "ecg_clip_uv": 2500,
      "ecg_step_uv": 1,
      "grid_ms": 8,
      "max_gap_ms": 50.0,
      "min_piece_s": 30.0,
      "rr_chain_lag_ms": 2000,
      "rr_range": [
        0,
        2500
      ],
      "sample_rate_hz": 125.0,
      "with_acc": false
    }
  },
  "torch_dtype": "float32",
  "transformers_version": "4.53.3",
  "use_qk_norm": false,
  "use_qk_norm_scale": false,
  "use_rotary_embeddings": true,
  "vocab_sizes": [
    5001,
    2501
  ]
}
